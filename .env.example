# Copy to .env for local development. In production, set these in the
# Vercel project settings (Settings -> Environment Variables).
# NEVER commit the real .env file.

# Required — MongoDB connection string
MONGODB_URI=

# Required — BetterAuth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5000

# Required — Frontend origin(s). Trailing slashes are stripped automatically.
CLIENT_URL=http://localhost:3000
# Optional — falls back to CLIENT_URL when unset
FRONTEND_URL=http://localhost:3000

# Required for Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional — local port (defaults to 5000; ignored on Vercel)
# PORT=5000
